{
  "bill_no": "2203602",
  "bill_name": "기초연금법 일부개정법률안(주호영의원 등 14인)",
  "propose_date": "2024-09-03",
  "cutoff": "2024-09-03",
  "estimation_period": "2026~2030 (2025년 재정소요 0)",
  "clauses": [
    {
      "id": "안 제3조제3항",
      "quote": "제1항에도 불구하고 대통령령으로 정하는 사람 중 19세 이후 국내에 7년 이상 거주하지 아니한 사람에게는 기초연금을 지급하지 아니한다.",
      "effect": "지출 감소(수급 제외)"
    },
    {
      "id": "안 제5조의2제1항",
      "quote": "제5조제2항 전단에도 불구하고 65세 이상인 사람 중 소득인정액이 일정비율 이하인 사람에게 적용하는 기준연금액은 다음 각 호의 구분에 따른다. 1. 소득인정액이 100분의 30 이하인 사람에 대한 2026년의 기준연금액: 40만원 2. 소득인정액이 100분의 50 이하인 사람에 대한 2027년의 기준연금액: 40만원",
      "effect": "지출 증가(추계)"
    },
    {
      "id": "안 제10조제3항",
      "quote": "기초연금 수급희망자와 그 배우자는 제1항에 따른 신청을 할 때 국외에 소득 또는 재산을 보유한 경우에는 이를 신고하여야 한다.",
      "effect": "행정절차(재정영향 미미/추정곤란)"
    },
    {
      "id": "법률 제16868호 부칙 제2조 삭제",
      "quote": "법률 제16868호 기초연금법 일부개정법률 부칙 제2조를 삭제한다.",
      "effect": "제5조의2 유효기간(2020.12.31.) 삭제 — 특례 상시화, 독립 재정효과 없음(제5조의2 개정효과에 포함)"
    },
    {
      "id": "부칙 제1조",
      "quote": "이 법은 공포 후 1년이 경과한 날부터 시행한다.",
      "effect": "추계기간 결정"
    }
  ],
  "not_estimated": [
    {
      "id": "안 제3조제3항",
      "reason": "적용대상('대통령령으로 정하는 사람', 예: 복수국적자·장기 해외거주 후 입국자)이 하위법령에 위임되어 있고, 19세 이후 국내 거주기간 7년 미만인 65세 이상 신규 신청자 수에 관한 공개 자료가 없음. 부칙 제2조에 따라 시행 후 최초 신청자부터 적용되므로 기존 수급자 영향 없음. 재정 감소요인이나 규모 추정 곤란"
    },
    {
      "id": "안 제10조제3항",
      "reason": "국외 소득·재산 신고의무 신설은 신청절차 규정으로 직접 지출을 수반하지 않음. 신고에 따른 부정수급 감소(지출 절감) 효과는 국외 보유 소득·재산 규모 자료가 없어 추정 곤란"
    },
    {
      "id": "소득역전방지 감액(현행 제8조제3항)·국민연금 연계감액(제5조·제6조)",
      "reason": "40만원 특례 경계구간(30%·50% 부근) 수급자의 감액 및 국민연금 연계감액은 소득구간별 미시자료가 없어 반영하지 못함 → 본 추계는 과대 가능성"
    },
    {
      "id": "행정비용(시스템 개편 등)",
      "reason": "기존 기초연금 전산 내 기준연금액 구분 적용으로 처리 가능하다고 보아 제외"
    }
  ],
