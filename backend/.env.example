# 생성형 LLM: gemini 또는 upstage
LLM_PROVIDER=gemini
# 선택 사항: Solar Pro2 실험 프로필. 비우면 공통 기본 프롬프트 사용.
LLM_PROFILE=

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro

# Upstage API (LLM_PROVIDER=upstage일 때 사용)
UPSTAGE_API_KEY=your-upstage-api-key
UPSTAGE_MODEL=solar-pro3
UPSTAGE_BASE_URL=https://api.upstage.ai/v1/chat/completions

# OpenAI (임베딩 및 ERCE 운영용 의안 분석)
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 기본은 manual: 개발 중 API 크레딧 사용 안 함. 운영에서만 gpt로 설정.
ERCE_AI_MODE=manual

# Azure OpenAI (선택 - OpenAI 폴백)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 국회 Open API
OPEN_ASSEMBLY_API_KEY=your-open-assembly-key

# 서버 포트 (선택)
BACKEND_PORT=8000
